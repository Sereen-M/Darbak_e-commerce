@model Darbak.ViewModels.AdminUserDetailsViewModel

@{
    ViewData["Title"] = "User Details";
}

<div class="d-flex
    justify-content-between
    align-items-start
    flex-wrap
    gap-3
    mb-4">

    <div>

        <h1 class="h2 mb-1">
            User Details
        </h1>

        <p class="text-muted mb-0">
            View user information and manage their role.
        </p>

    </div>

    <a asp-controller="AdminUsers"
       asp-action="Index"
       class="btn btn-outline-secondary">
        Back to Users
    </a>

</div>

<div class="row g-4">

    <div class="col-12 col-lg-7">

        <section class="card h-100 shadow-sm"
                 aria-labelledby="user-information-heading">

            <div class="card-header">

                <h2 id="user-information-heading"
                    class="h5 mb-0">
                    User Information
                </h2>

            </div>

            <div class="card-body">

                <dl class="row mb-0">

                    <dt class="col-sm-4">
                        Full Name
                    </dt>

                    <dd class="col-sm-8">

                        @if (string.IsNullOrWhiteSpace(
                            Model.FullName))
                        {
                            <span class="text-muted">
                                Not provided
                            </span>
                        }
                        else
                        {
                            @Model.FullName
                        }

                    </dd>

                    <dt class="col-sm-4">
                        Email
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Email
                    </dd>

                    <dt class="col-sm-4">
                        Username
                    </dt>

                    <dd class="col-sm-8">

                        @if (string.IsNullOrWhiteSpace(
                            Model.UserName))
                        {
                            <span class="text-muted">
                                Not provided
                            </span>
                        }
                        else
                        {
                            @Model.UserName
                        }

                    </dd>

                    <dt class="col-sm-4">
                        Current Role
                    </dt>

                    <dd class="col-sm-8 mb-0">

                        @if (!Model.Roles.Any())
                        {
                            <span class="badge bg-secondary">
                                No Role
                            </span>
                        }
                        else
                        {
                            @foreach (var role in Model.Roles)
                            {
                                if (role == "Admin")
                                {
                                    <span class="badge
                                        bg-danger
                                        me-1">
                                        Admin
                                    </span>
                                }
                                else
                                {
                                    <span class="badge
                                        bg-primary
                                        me-1">
                                        @role
                                    </span>
                                }
                            }
                        }

                    </dd>

                </dl>

            </div>

        </section>

    </div>

    <div class="col-12 col-lg-5">

        <section class="card shadow-sm"
                 aria-labelledby="change-role-heading">

            <div class="card-header">

                <h2 id="change-role-heading"
                    class="h5 mb-0">
                    Change Role
                </h2>

            </div>

            <div class="card-body">

                <form asp-controller="AdminUsers"
                      asp-action="ChangeRole"
                      method="post">

                    <input type="hidden"
                           name="userId"
                           value="@Model.Id" />

                    <div class="mb-3">

                        <label for="selectedRole"
                               class="form-label">
                            Role
                        </label>

                        <select id="selectedRole"
                                name="selectedRole"
                                class="form-select">

                            @if (Model.SelectedRole == "User")
                            {
                                <option value="User"
                                        selected>
                                    User
                                </option>

                                <option value="Admin">
                                    Admin
                                </option>
                            }
                            else
                            {
                                <option value="User">
                                    User
                                </option>

                                <option value="Admin"
                                        selected>
                                    Admin
                                </option>
                            }

                        </select>

                    </div>

                    <div class="alert alert-warning"
                         role="note">

                        Changing a user's role changes
                        their access permissions immediately.

                    </div>

                    <button type="submit"
                            class="btn btn-primary">
                        Save Role
                    </button>

                </form>

            </div>

        </section>

    </div>

</div>