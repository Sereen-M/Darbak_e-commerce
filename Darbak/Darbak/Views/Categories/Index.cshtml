@model IEnumerable<Darbak.Models.Category>

@{
    ViewData["Title"] = "Categories";

    var search =
        ViewBag.Search as string;
}

<h1 class="mb-4">
    Categories
</h1>

@if (TempData["CategorySuccess"] != null)
{
    <div class="alert alert-success">
        @TempData["CategorySuccess"]
    </div>
}

@if (TempData["CategoryError"] != null)
{
    <div class="alert alert-danger">
        @TempData["CategoryError"]
    </div>
}

<div class="card mb-4">

    <div class="card-header">
        <strong>
            Filter Categories
        </strong>
    </div>

    <div class="card-body">

        <form asp-action="Index"
              method="get">

            <div class="row g-3">

                <div class="col-md-6">

                    <label for="search"
                           class="form-label">
                        Category Name
                    </label>

                    <input type="text"
                           id="search"
                           name="search"
                           value="@search"
                           class="form-control"
                           placeholder="Search by category name" />

                </div>

            </div>

            <div class="d-flex gap-2 mt-4">

                <button type="submit"
                        class="btn btn-primary">
                    Apply Filter
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Reset Filter
                </a>

            </div>

        </form>

    </div>

</div>

<div class="d-flex
    justify-content-between
    align-items-center
    mb-3">

    <a asp-action="Create"
       class="btn btn-primary">
        Add Category
    </a>

    <span class="badge bg-secondary">
        @Model.Count() result(s)
    </span>

</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No categories match the selected filter.
    </div>
}
else
{
    <div class="table-responsive">

        <table class="table
            table-bordered
            table-hover
            align-middle">

            <thead>

                <tr>
                    <th>Id</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Actions</th>
                </tr>

            </thead>

            <tbody>

                @foreach (var category in Model)
                {
                    <tr>

                        <td>
                            @category.Id
                        </td>

                        <td>
                            @category.Name
                        </td>

                        <td>
                            @(string.IsNullOrWhiteSpace(
                                category.Description)
                                ? "-"
                                : category.Description)
                        </td>

                        <td>

                            <div class="d-flex gap-1">

                                <a asp-action="Edit"
                                   asp-route-id="@category.Id"
                                   class="btn
                                    btn-warning
                                    btn-sm">
                                    Edit
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@category.Id"
                                   class="btn
                                    btn-danger
                                    btn-sm">
                                    Delete
                                </a>

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>
}