@model IEnumerable<Darbak.Models.Testimonial>

@{
    ViewData["Title"] = "Manage Testimonials";
}

<h1 class="mb-4">Manage Testimonials</h1>

@if (!Model.Any())
{
    <div class="text-center
        border
        rounded
        bg-light
        p-4">

        <h2 class="h5 mb-2">
            No testimonials yet
        </h2>

        <p class="text-muted mb-0">
            No testimonials have been submitted yet.
        </p>

    </div>
}
else
{
    <div class="table-responsive">

        <table class="table table-bordered align-middle">
            <caption class="visually-hidden">
                Testimonials available for moderation
            </caption>
            <thead>
                <tr>
                    <th scope="col">User</th>
                    <th scope="col">Content</th>
                    <th scope="col">Status</th>
                    <th scope="col">Date</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var testimonial in Model)
                {
                    <tr>

                        <td>
                            @(string.IsNullOrWhiteSpace(testimonial.User.FullName)
                                ? testimonial.User.UserName
                                : testimonial.User.FullName)
                        </td>

                        <td>
                            @testimonial.Content
                        </td>

                        <td>
                            @if (testimonial.Status ==
                                Darbak.Models.Enums.ApprovalStatus.Pending)
                            {
                                <span class="badge bg-warning text-dark">
                                    Pending
                                </span>
                            }
                            else if (testimonial.Status ==
                                     Darbak.Models.Enums.ApprovalStatus.Approved)
                            {
                                <span class="badge bg-success">
                                    Approved
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    Rejected
                                </span>
                            }
                        </td>

                        <td>
                            @testimonial.CreatedAt.ToString("yyyy-MM-dd")
                        </td>

                        <td>

                            <div class="d-flex
                                flex-wrap
                                gap-2">

                                @if (testimonial.Status !=
                                     Darbak.Models.Enums.ApprovalStatus.Approved)
                                {
                                    <form asp-action="Approve"
                                          method="post">

                                        <input type="hidden"
                                               name="id"
                                               value="@testimonial.Id" />

                                        <button type="submit"
                                                class="btn btn-success btn-sm">
                                            Approve
                                        </button>

                                    </form>
                                }

                                @if (testimonial.Status !=
                                     Darbak.Models.Enums.ApprovalStatus.Rejected)
                                {
                                    <form asp-action="Reject"
                                          method="post">

                                        <input type="hidden"
                                               name="id"
                                               value="@testimonial.Id" />

                                        <button type="submit"
                                                class="btn btn-danger btn-sm">
                                            Reject
                                        </button>

                                    </form>
                                }

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>
}