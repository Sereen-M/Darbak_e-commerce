@model IEnumerable<Darbak.Models.Testimonial>

@{
    ViewData["Title"] = "Testimonials";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <h1>Testimonials</h1>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-action="Create"
           class="btn btn-primary">
            Add Testimonial
        </a>
    }

</div>

@if (TempData["TestimonialSuccess"] != null)
{
    <div class="alert alert-success">
        @TempData["TestimonialSuccess"]
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        No testimonials are available yet.
    </div>
}
else
{
    <div class="row">

        @foreach (var testimonial in Model)
        {
            <div class="col-md-6 mb-4">

                <div class="card h-100">

                    <div class="card-body">

                        <p class="card-text">
                            @testimonial.Content
                        </p>

                        <hr />

                        <div class="d-flex justify-content-between">

                            <strong>
                                @(string.IsNullOrWhiteSpace(
                                    testimonial.User.FullName)
                                    ? testimonial.User.UserName
                                    : testimonial.User.FullName)
                            </strong>

                            <small class="text-muted">
                                @testimonial.CreatedAt.ToString("yyyy-MM-dd")
                            </small>

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>
}