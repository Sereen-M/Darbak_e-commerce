@model IEnumerable<Darbak.Models.Testimonial>

@{
    ViewData["Title"] = "Testimonials";
}

<div class="d-flex
    justify-content-between
    align-items-center
    flex-wrap
    gap-3
    mb-4">
    <h1>Testimonials</h1>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-action="Create"
           class="btn btn-primary">
            Add Testimonial
        </a>
    }

</div>

@if (!Model.Any())
{
    <div class="text-center
        border
        rounded
        bg-light
        p-5">

        <h2 class="h4 mb-2">
            No testimonials yet
        </h2>

        <p class="text-muted mb-3">
            Approved customer testimonials will appear here.
        </p>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-action="Create"
               class="btn btn-primary">
                Add Testimonial
            </a>
        }

    </div>
}
else
{
    <div class="row g-4">
        @foreach (var testimonial in Model)
        {
            <div class="col-12 col-md-6">
                <article class="card h-100 shadow-sm">
                    <div class="card-body">

                        <p class="card-text">
                            @testimonial.Content
                        </p>

                        <hr />

                        <div class="d-flex
                            justify-content-between
                            align-items-center
                            flex-wrap
                            gap-2">
                            <strong>
                                @(string.IsNullOrWhiteSpace(
                                    testimonial.User.FullName)
                                    ? testimonial.User.UserName
                                    : testimonial.User.FullName)
                            </strong>

                            <small class="text-muted">
                                @testimonial.CreatedAt.ToString("yyyy-MM-dd")
                            </small>

                        </div>

                    </div>

                </article>
            </div>
        }

    </div>
}