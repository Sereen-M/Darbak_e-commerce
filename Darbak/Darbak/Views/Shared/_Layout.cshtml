<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Darbak</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/Darbak.styles.css"
          asp-append-version="true" />
</head>

<body class="d-flex flex-column min-vh-100">

    <a class="skip-link"
       href="#main-content">
        Skip to main content
    </a>

    <header>

        <nav class="navbar
                    navbar-expand-lg
                    navbar-light
                    bg-white
                    border-bottom
                    shadow-sm"
             aria-label="Main navigation">

            <div class="container">

                <a class="navbar-brand fw-bold"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    Darbak
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse"
                     id="mainNavbar">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Catalog"
                               asp-action="Index">
                                Catalog
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="About">
                                About
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Testimonials"
                               asp-action="Index">
                                Testimonials
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Cart"
                               asp-action="Index">
                                Cart
                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Wishlist"
                                   asp-action="Index">
                                    Wishlist
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Orders"
                                   asp-action="Index">
                                    My Orders
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">

                                <a class="nav-link dropdown-toggle"
                                   href="#"
                                   id="adminDropdown"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">
                                    Admin
                                </a>

                                <ul class="dropdown-menu"
                                    aria-labelledby="adminDropdown">

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="AdminDashboard"
                                           asp-action="Index">
                                            Dashboard
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="AdminUsers"
                                           asp-action="Index">
                                            Users
                                        </a>
                                    </li>

                                    <li>
                                        <hr class="dropdown-divider" />
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Categories"
                                           asp-action="Index">
                                            Categories
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Products"
                                           asp-action="Index">
                                            Products
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Orders"
                                           asp-action="AdminIndex">
                                            Orders
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Reviews"
                                           asp-action="Index">
                                            Reviews
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Testimonials"
                                           asp-action="AdminIndex">
                                            Testimonials
                                        </a>
                                    </li>

                                </ul>

                            </li>
                        }

                    </ul>

                    <partial name="_LoginPartial" />

                </div>

            </div>

        </nav>

    </header>

    <partial name="_ToastNotifications" />

    <main id="main-content"
          class="container flex-grow-1 py-4"
          role="main">

        @RenderBody()

    </main>

    <footer class="border-top bg-light text-muted mt-auto">

        <div class="container py-4">

            <div class="row g-4">

                <div class="col-12 col-md-4">

                    <h5 class="text-dark">
                        Darbak
                    </h5>

                    <p class="mb-0">
                        Auto parts and car accessories
                        for your journey.
                    </p>

                </div>

                <div class="col-6 col-md-4">

                    <h6 class="text-dark">
                        Quick Links
                    </h6>

                    <ul class="list-unstyled mb-0">

                        <li class="mb-2">
                            <a asp-controller="Home"
                               asp-action="Index"
                               class="footer-link">
                                Home
                            </a>
                        </li>

                        <li class="mb-2">
                            <a asp-controller="Catalog"
                               asp-action="Index"
                               class="footer-link">
                                Catalog
                            </a>
                        </li>

                        <li class="mb-2">
                            <a asp-controller="Home"
                               asp-action="About"
                               class="footer-link">
                                About
                            </a>
                        </li>

                        <li>
                            <a asp-controller="Testimonials"
                               asp-action="Index"
                               class="footer-link">
                                Testimonials
                            </a>
                        </li>

                    </ul>

                </div>

                <div class="col-6 col-md-4">

                    <h6 class="text-dark">
                        Account
                    </h6>

                    <ul class="list-unstyled mb-0">

                        <li class="mb-2">
                            <a asp-controller="Cart"
                               asp-action="Index"
                               class="footer-link">
                                Cart
                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="mb-2">
                                <a asp-controller="Wishlist"
                                   asp-action="Index"
                                   class="footer-link">
                                    Wishlist
                                </a>
                            </li>

                            <li class="mb-2">
                                <a asp-controller="Orders"
                                   asp-action="Index"
                                   class="footer-link">
                                    My Orders
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="mb-2">
                                <a asp-controller="AdminDashboard"
                                   asp-action="Index"
                                   class="footer-link">
                                    Admin Dashboard
                                </a>
                            </li>
                        }

                    </ul>

                </div>

            </div>

            <hr class="my-4" />

            <div class="text-center small">

                &copy; @DateTime.Now.Year Darbak.
                All rights reserved.

            </div>

        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync(
        "Scripts",
        required: false
    )

</body>

</html>