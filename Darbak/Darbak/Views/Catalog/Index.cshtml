@model Darbak.ViewModels.CatalogViewModel

@{
    ViewData["Title"] = "Catalog";
}

<h1 class="mb-4">Products</h1>

<form asp-action="Index"
      method="get"
      class="row g-3 mb-4">

    <div class="col-md-4">

        <label for="catalogSearch"
               class="form-label">
            Search
        </label>

        <input type="text"
               id="catalogSearch"
               name="search"
               value="@Model.Search"
               class="form-control"
               placeholder="Search products..."
               aria-describedby="catalogSearchHelp" />

        <div id="catalogSearchHelp"
             class="form-text">
            Search by product or category name.
        </div>

    </div>

    <div class="col-md-3">

        <label for="catalogCategory"
               class="form-label">
            Category
        </label>

        <select id="catalogCategory"
                name="categoryId"
                class="form-select">

            <option value="">
                All Categories
            </option>

            @foreach (var category in Model.Categories)
            {
                if (Model.CategoryId == category.Id)
                {
                    <option value="@category.Id"
                            selected>
                        @category.Name
                    </option>
                }
                else
                {
                    <option value="@category.Id">
                        @category.Name
                    </option>
                }
            }

        </select>

    </div>

    <div class="col-md-3">

        <label for="catalogSort"
               class="form-label">
            Sort By
        </label>

        <select id="catalogSort"
                name="sort"
                class="form-select">

            <option value=""
                    selected="@(string.IsNullOrEmpty(Model.Sort))">
                Newest
            </option>

            <option value="price_asc"
                    selected="@(Model.Sort == "price_asc")">
                Price: Low to High
            </option>

            <option value="price_desc"
                    selected="@(Model.Sort == "price_desc")">
                Price: High to Low
            </option>

        </select>

    </div>

    <div class="col-md-2 d-flex align-items-end">

        <button type="submit"
                class="btn btn-primary w-100">
            Apply
        </button>

    </div>

</form>

@if (!Model.Products.Any())
{
    <div class="text-center border rounded p-5 bg-light">

        <h2 class="h4 mb-2">
            No products found
        </h2>

        <p class="text-muted mb-3">
            Try changing your search, category, or sorting options.
        </p>

        <a asp-action="Index"
           class="btn btn-outline-primary">
            Clear Filters
        </a>

    </div>
}
else
{
    <div class="row g-4">

        @foreach (var product in Model.Products)
        {
            var productTitleId =
                $"product-title-{product.Id}";

            <div class="col-12 col-sm-6 col-lg-4 col-xl-3">

                <article class="card h-100 shadow-sm"
                         aria-labelledby="@productTitleId">

                    @if (!string.IsNullOrWhiteSpace(product.MainImageUrl))
                    {
                        <img src="@product.MainImageUrl"
                             class="card-img-top"
                             alt="@product.Name"
                             loading="lazy"
                             style="height: 220px;
                        object-fit: cover;" />
                    }
                    else
                    {
                        <div class="d-flex
                            align-items-center
                            justify-content-center
                            bg-light
                            text-muted"
                             style="height: 220px;"
                             aria-label="No product image available">

                            No Image

                        </div>
                    }

                    <div class="card-body d-flex flex-column">

                        <h2 id="@productTitleId"
                            class="card-title h5">

                            @product.Name

                        </h2>

                        <p class="text-muted mb-2">
                            @product.CategoryName
                        </p>

                        <p class="fw-bold fs-5 mb-2">
                            @product.Price.ToString("0.00")
                        </p>

                        <div class="mb-2">

                            @if (product.ReviewCount > 0)
                            {
                                <span>
                                    @product.AverageRating.ToString("0.0")
                                    / 5
                                </span>

                                <small class="text-muted">
                                    (@product.ReviewCount reviews)
                                </small>
                            }
                            else
                            {
                                <span class="text-muted">
                                    No reviews yet
                                </span>
                            }

                        </div>

                        <div class="mb-3">

                            @if (product.StockQuantity > 0)
                            {
                                <span class="badge bg-success"
                                      role="status">
                                    In Stock
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger"
                                      role="status">
                                    Out of Stock
                                </span>
                            }

                        </div>

                        <div class="mt-auto">

                            <a asp-controller="Products"
                               asp-action="Details"
                               asp-route-id="@product.Id"
                               class="btn btn-outline-primary w-100 mb-2"
                               aria-label="View details for @product.Name">

                                View Details

                            </a>

                            @if (product.StockQuantity > 0)
                            {
                                <form asp-controller="Cart"
                                      asp-action="AddToCart"
                                      method="post"
                                      class="mb-2">

                                    <input type="hidden"
                                           name="productId"
                                           value="@product.Id" />

                                    <button type="submit"
                                            class="btn btn-primary w-100"
                                            aria-label="Add @product.Name to cart">

                                        Add to Cart

                                    </button>

                                </form>
                            }
                            else
                            {
                                <button type="button"
                                        class="btn btn-secondary w-100 mb-2"
                                        disabled>

                                    Out of Stock

                                </button>
                            }

                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <form asp-controller="Wishlist"
                                      asp-action="Add"
                                      method="post">

                                    <input type="hidden"
                                           name="productId"
                                           value="@product.Id" />

                                    <button type="submit"
                                            class="btn btn-outline-secondary w-100"
                                            aria-label="Add @product.Name to wishlist">

                                        Add to Wishlist

                                    </button>

                                </form>
                            }

                        </div>

                    </div>

                </article>

            </div>
        }

    </div>
}