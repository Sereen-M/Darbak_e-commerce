@model Darbak.ViewModels.MockPaymentViewModel

@{
    ViewData["Title"] = "Payment";
}

<div class="row justify-content-center">

    <div class="col-12 col-lg-9">

        <div class="mb-4">

            <h1 class="h2 mb-1">
                Payment
            </h1>

            <p class="text-muted mb-0">
                Review your order before completing the demo payment.
            </p>

        </div>

        <div class="alert alert-warning"
             role="note">

            <strong>
                Demo Payment
            </strong>

            <div>
                This is a simulated payment.
                No real card or payment information is required.
            </div>

        </div>

        <section class="card shadow-sm mb-4"
                 aria-labelledby="payment-shipping-heading">

            <div class="card-header">

                <h2 id="payment-shipping-heading"
                    class="h5 mb-0">
                    Shipping Information
                </h2>

            </div>

            <div class="card-body">

                <dl class="row mb-0">

                    <dt class="col-sm-3">
                        Address
                    </dt>

                    <dd class="col-sm-9">
                        @Model.ShippingAddress
                    </dd>

                    <dt class="col-sm-3">
                        City
                    </dt>

                    <dd class="col-sm-9">
                        @Model.City
                    </dd>

                    <dt class="col-sm-3">
                        Phone
                    </dt>

                    <dd class="col-sm-9 mb-0">
                        @Model.PhoneNumber
                    </dd>

                </dl>

            </div>

        </section>

        <section class="card shadow-sm mb-4"
                 aria-labelledby="payment-summary-heading">

            <div class="card-header">

                <h2 id="payment-summary-heading"
                    class="h5 mb-0">
                    Order Summary
                </h2>

            </div>

            <div class="card-body">

                <div class="table-responsive">

                    <table class="table align-middle">

                        <caption class="visually-hidden">
                            Products included in the demo payment
                        </caption>

                        <thead>

                            <tr>

                                <th scope="col">
                                    Product
                                </th>

                                <th scope="col"
                                    class="text-center">
                                    Quantity
                                </th>

                                <th scope="col"
                                    class="text-end">
                                    Price
                                </th>

                                <th scope="col"
                                    class="text-end">
                                    Total
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in Model.CartItems)
                            {
                                <tr>

                                    <td>
                                        @item.ProductName
                                    </td>

                                    <td class="text-center">
                                        @item.Quantity
                                    </td>

                                    <td class="text-end text-nowrap">
                                        @item.Price.ToString("0.00")
                                    </td>

                                    <td class="text-end text-nowrap">
                                        @item.Total.ToString("0.00")
                                    </td>

                                </tr>
                            }

                        </tbody>

                        <tfoot>

                            <tr>

                                <th colspan="3"
                                    scope="row"
                                    class="text-end">
                                    Total
                                </th>

                                <th class="text-end text-nowrap">
                                    @Model.TotalAmount.ToString("0.00")
                                </th>

                            </tr>

                        </tfoot>

                    </table>

                </div>

            </div>

        </section>

        <div class="d-grid gap-2 d-sm-flex">

            <form asp-action="CompletePayment"
                  method="post"
                  id="paymentForm">

                <input type="hidden"
                       name="paymentToken"
                       value="@Model.PaymentToken" />

                <button type="submit"
                        id="completePaymentButton"
                        class="btn btn-success btn-lg">

                    Complete Payment

                </button>

            </form>

            <form asp-action="CancelPayment"
                  method="post">

                <button type="submit"
                        class="btn btn-outline-secondary btn-lg">

                    Cancel Payment

                </button>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    <script>
        document
            .getElementById("paymentForm")
            .addEventListener("submit", function () {

                const button =
                    document.getElementById(
                        "completePaymentButton"
                    );

                button.disabled = true;
                button.innerText = "Processing...";
            });
    </script>
}