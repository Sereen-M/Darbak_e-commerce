@model Darbak.ViewModels.CheckoutViewModel

@{
    ViewData["Title"] = "Checkout";
}

<h1 class="mb-4">
    Checkout
</h1>

@if (TempData["CheckoutInfo"] != null)
{
    <div class="alert alert-info">
        @TempData["CheckoutInfo"]
    </div>
}

<form asp-action="Checkout"
      method="post"
      id="checkoutForm">

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger">
    </div>

    <div class="row g-4">

        <div class="col-md-7">

            <div class="card">

                <div class="card-header">
                    <strong>
                        Shipping Information
                    </strong>
                </div>

                <div class="card-body">

                    <div class="mb-3">

                        <label asp-for="ShippingAddress"
                               class="form-label">
                        </label>

                        <input asp-for="ShippingAddress"
                               class="form-control" />

                        <span asp-validation-for="ShippingAddress"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="City"
                               class="form-label">
                        </label>

                        <input asp-for="City"
                               class="form-control" />

                        <span asp-validation-for="City"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="PhoneNumber"
                               class="form-label">
                        </label>

                        <input asp-for="PhoneNumber"
                               type="tel"
                               class="form-control" />

                        <span asp-validation-for="PhoneNumber"
                              class="text-danger">
                        </span>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-md-5">

            <div class="card">

                <div class="card-header">
                    <strong>
                        Order Summary
                    </strong>
                </div>

                <div class="card-body">

                    <div class="table-responsive">

                        <table class="table">

                            <thead>

                                <tr>
                                    <th>Product</th>
                                    <th>Qty</th>
                                    <th>Total</th>
                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var item
                                    in Model.CartItems)
                                {
                                    <tr>

                                        <td>
                                            @item.ProductName
                                        </td>

                                        <td>
                                            @item.Quantity
                                        </td>

                                        <td>
                                            @item.Total
                                            .ToString("0.00")
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                    <h5 class="mb-3">

                        Total:

                        @Model.TotalAmount
                        .ToString("0.00")

                    </h5>

                    <button type="submit"
                            id="continueButton"
                            class="btn btn-success">
                        Continue to Payment
                    </button>

                    <a asp-controller="Cart"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Back to Cart
                    </a>

                </div>

            </div>

        </div>

    </div>

</form>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        document
            .getElementById("checkoutForm")
            .addEventListener(
                "submit",
                function() {

                    if (!$(this).valid()) {
                        return;
                    }

                    const button =
                        document.getElementById(
                            "continueButton");

                    button.disabled = true;

                    button.innerText =
                        "Preparing Payment...";
                });
    </script>
}