@using Darbak.Models.Enums
@model Darbak.Models.Order

@{
    ViewData["Title"] = $"Manage Order #{Model.Id}";
}

<div class="d-flex
    justify-content-between
    align-items-start
    flex-wrap
    gap-3
    mb-4">

    <div>
        <h1 class="h2 mb-1">
            Manage Order #@Model.Id
        </h1>

        <p class="text-muted mb-0">
            Review customer information and manage order status.
        </p>
    </div>

    <div class="d-flex flex-wrap gap-2">

        <a asp-action="Invoice"
           asp-route-id="@Model.Id"
           class="btn btn-outline-primary">
            View Invoice
        </a>

        <a asp-action="AdminIndex"
           class="btn btn-outline-secondary">
            Back to Orders
        </a>

    </div>

</div>

<div class="row g-4 mb-4">

    <div class="col-12 col-lg-6">

        <section class="card h-100 shadow-sm"
                 aria-labelledby="customer-information-heading">

            <div class="card-header">

                <h2 id="customer-information-heading"
                    class="h5 mb-0">
                    Customer Information
                </h2>

            </div>

            <div class="card-body">

                <dl class="row mb-0">

                    <dt class="col-sm-4">
                        Name
                    </dt>

                    <dd class="col-sm-8">

                        @if (!string.IsNullOrWhiteSpace(Model.User.FullName))
                        {
                            @Model.User.FullName
                        }
                        else
                        {
                            <span class="text-muted">
                                Not provided
                            </span>
                        }

                    </dd>

                    <dt class="col-sm-4">
                        Email
                    </dt>

                    <dd class="col-sm-8">
                        @Model.User.Email
                    </dd>

                    <dt class="col-sm-4">
                        Order Date
                    </dt>

                    <dd class="col-sm-8 mb-0">

                        @Model.OrderDate
                        .ToLocalTime()
                        .ToString("dd/MM/yyyy HH:mm")

                    </dd>

                </dl>

            </div>

        </section>

    </div>

    <div class="col-12 col-lg-6">

        <section class="card h-100 shadow-sm"
                 aria-labelledby="shipping-information-heading">

            <div class="card-header">

                <h2 id="shipping-information-heading"
                    class="h5 mb-0">
                    Shipping Information
                </h2>

            </div>

            <div class="card-body">

                <dl class="row mb-0">

                    <dt class="col-sm-4">
                        Address
                    </dt>

                    <dd class="col-sm-8">
                        @Model.ShippingAddress
                    </dd>

                    <dt class="col-sm-4">
                        City
                    </dt>

                    <dd class="col-sm-8">
                        @Model.City
                    </dd>

                    <dt class="col-sm-4">
                        Phone
                    </dt>

                    <dd class="col-sm-8 mb-0">
                        @Model.PhoneNumber
                    </dd>

                </dl>

            </div>

        </section>

    </div>

</div>

<div class="row g-4 mb-4">

    <div class="col-12 col-md-6">

        <section class="card h-100 shadow-sm"
                 aria-labelledby="order-status-heading">

            <div class="card-header">

                <h2 id="order-status-heading"
                    class="h5 mb-0">
                    Order Status
                </h2>

            </div>

            <div class="card-body">

                <form asp-action="UpdateStatus"
                      method="post">

                    <input type="hidden"
                           name="id"
                           value="@Model.Id" />

                    <div class="mb-3">

                        <label for="orderStatus"
                               class="form-label">
                            Select Order Status
                        </label>

                        <select asp-for="Status"
                                id="orderStatus"
                                asp-items="Html.GetEnumSelectList<OrderStatus>()"
                                class="form-select">
                        </select>

                    </div>

                    <button type="submit"
                            class="btn btn-primary">
                        Update Order Status
                    </button>

                </form>

            </div>

        </section>

    </div>

    <div class="col-12 col-md-6">

        <section class="card h-100 shadow-sm"
                 aria-labelledby="payment-status-heading">

            <div class="card-header">

                <h2 id="payment-status-heading"
                    class="h5 mb-0">
                    Payment Status
                </h2>

            </div>

            <div class="card-body">

                <form asp-action="UpdatePaymentStatus"
                      method="post">

                    <input type="hidden"
                           name="id"
                           value="@Model.Id" />

                    <div class="mb-3">

                        <label for="paymentStatus"
                               class="form-label">
                            Select Payment Status
                        </label>

                        <select asp-for="PaymentStatus"
                                id="paymentStatus"
                                asp-items="Html.GetEnumSelectList<PaymentStatus>()"
                                class="form-select">
                        </select>

                    </div>

                    <button type="submit"
                            class="btn btn-primary">
                        Update Payment Status
                    </button>

                </form>

            </div>

        </section>

    </div>

</div>

<section aria-labelledby="order-items-heading"
         class="mb-4">

    <div class="d-flex
        justify-content-between
        align-items-center
        flex-wrap
        gap-2
        mb-3">

        <h2 id="order-items-heading"
            class="h4 mb-0">
            Order Items
        </h2>

        <strong class="fs-5">
            Total: @Model.TotalAmount.ToString("0.00")
        </strong>

    </div>

    <div class="table-responsive">

        <table class="table
            table-bordered
            table-hover
            align-middle">

            <caption class="visually-hidden">
                Products included in order @Model.Id
            </caption>

            <thead class="table-light">

                <tr>

                    <th scope="col">
                        Product
                    </th>

                    <th scope="col"
                        class="text-end">
                        Unit Price
                    </th>

                    <th scope="col"
                        class="text-center">
                        Quantity
                    </th>

                    <th scope="col"
                        class="text-end">
                        Total
                    </th>

                </tr>

            </thead>

            <tbody>

                @foreach (var item in Model.OrderItems)
                {
                    <tr>

                        <td>
                            @item.ProductName
                        </td>

                        <td class="text-end text-nowrap">
                            @item.UnitPrice.ToString("0.00")
                        </td>

                        <td class="text-center">
                            @item.Quantity
                        </td>

                        <td class="text-end text-nowrap">

                            @((item.UnitPrice * item.Quantity)
                                .ToString("0.00"))

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</section>

<div class="d-grid
    gap-2
    d-sm-flex">

    <a asp-action="Invoice"
       asp-route-id="@Model.Id"
       class="btn btn-primary">
        View Invoice
    </a>

    <a asp-action="AdminIndex"
       class="btn btn-outline-secondary">
        Back to Orders
    </a>

</div>