@using Darbak.Models.Enums
@model Darbak.Models.Order

@{
    ViewData["Title"] = $"Invoice #{Model.Id}";
}

<div class="invoice-container">

    <div class="d-flex
        justify-content-between
        align-items-start
        flex-wrap
        gap-3
        mb-4">

        <div>

            <h1 class="h2 mb-1">
                Darbak
            </h1>

            <p class="text-muted mb-0">
                Auto Parts & Car Accessories
            </p>

        </div>

        <div class="text-md-end">

            <h2 class="h3 mb-2">
                Invoice
            </h2>

            <p class="mb-1">
                <strong>Order #:</strong>
                @Model.Id
            </p>

            <p class="mb-0">
                <strong>Date:</strong>

                @Model.OrderDate
                .ToLocalTime()
                .ToString("dd/MM/yyyy HH:mm")
            </p>

        </div>

    </div>

    <hr />

    <div class="row g-4 mb-4">

        <section class="col-12 col-md-6"
                 aria-labelledby="customer-heading">

            <h3 id="customer-heading"
                class="h5">
                Customer Information
            </h3>

            <dl class="mb-0">

                <dt>
                    Name
                </dt>

                <dd>
                    @(string.IsNullOrWhiteSpace(Model.User?.FullName)
                        ? "Customer"
                        : Model.User.FullName)
                </dd>

                <dt>
                    Email
                </dt>

                <dd>
                    @(Model.User?.Email ?? "Not available")
                </dd>

                <dt>
                    Phone
                </dt>

                <dd class="mb-0">
                    @Model.PhoneNumber
                </dd>

            </dl>

        </section>

        <section class="col-12 col-md-6"
                 aria-labelledby="invoice-shipping-heading">

            <h3 id="invoice-shipping-heading"
                class="h5">
                Shipping Information
            </h3>

            <dl class="mb-0">

                <dt>
                    Address
                </dt>

                <dd>
                    @Model.ShippingAddress
                </dd>

                <dt>
                    City
                </dt>

                <dd class="mb-0">
                    @Model.City
                </dd>

            </dl>

        </section>

    </div>

    <div class="row g-3 mb-4">

        <div class="col-12 col-md-6">

            <strong>
                Order Status:
            </strong>

            @if (Model.Status == OrderStatus.Processing)
            {
                <span class="badge bg-warning text-dark"
                      role="status">
                    Processing
                </span>
            }
            else if (Model.Status == OrderStatus.Completed)
            {
                <span class="badge bg-success"
                      role="status">
                    Completed
                </span>
            }
            else
            {
                <span class="badge bg-danger"
                      role="status">
                    Cancelled
                </span>
            }

        </div>

        <div class="col-12 col-md-6">

            <strong>
                Payment Status:
            </strong>

            @switch (Model.PaymentStatus)
            {
                case PaymentStatus.Paid:
                    <span class="badge bg-success"
                          role="status">
                        Paid
                    </span>
                    break;

                case PaymentStatus.Failed:
                    <span class="badge bg-danger"
                          role="status">
                        Failed
                    </span>
                    break;

                case PaymentStatus.Refunded:
                    <span class="badge bg-info text-dark"
                          role="status">
                        Refunded
                    </span>
                    break;

                default:
                    <span class="badge bg-warning text-dark"
                          role="status">
                        Pending
                    </span>
                    break;
            }

        </div>

    </div>

    <div class="table-responsive">

        <table class="table
            table-bordered
            align-middle">

            <caption class="visually-hidden">
                Invoice items for order @Model.Id
            </caption>

            <thead class="table-light">

                <tr>

                    <th scope="col">
                        Product
                    </th>

                    <th scope="col"
                        class="text-end">
                        Unit Price
                    </th>

                    <th scope="col"
                        class="text-center">
                        Quantity
                    </th>

                    <th scope="col"
                        class="text-end">
                        Line Total
                    </th>

                </tr>

            </thead>

            <tbody>

                @foreach (var item in Model.OrderItems)
                {
                    <tr>

                        <td>
                            @item.ProductName
                        </td>

                        <td class="text-end text-nowrap">
                            @item.UnitPrice.ToString("0.00")
                        </td>

                        <td class="text-center">
                            @item.Quantity
                        </td>

                        <td class="text-end text-nowrap">
                            @((item.UnitPrice * item.Quantity)
                                .ToString("0.00"))
                        </td>

                    </tr>
                }

            </tbody>

            <tfoot>

                <tr>

                    <th colspan="3"
                        scope="row"
                        class="text-end">
                        Grand Total
                    </th>

                    <th class="text-end text-nowrap">
                        @Model.TotalAmount.ToString("0.00")
                    </th>

                </tr>

            </tfoot>

        </table>

    </div>

    <div class="d-grid
        gap-2
        d-sm-flex
        mt-4
        no-print">

        <button type="button"
                class="btn btn-primary"
                onclick="window.print();">
            Print Invoice
        </button>

        @if (User.IsInRole("Admin"))
        {
            <a asp-action="AdminDetails"
               asp-route-id="@Model.Id"
               class="btn btn-outline-secondary">
                Back to Order
            </a>
        }
        else
        {
            <a asp-action="Details"
               asp-route-id="@Model.Id"
               class="btn btn-outline-secondary">
                Back to Order
            </a>
        }

    </div>

</div>

<style>
    @@media print {

        header,
        footer,
        nav,
        .no-print,
        .toast-container,
        .skip-link {
            display: none !important;
        }

        body {
            background: white !important;
        }

        main.container {
            max-width: none !important;
            width: 100% !important;
            padding: 0 !important;
        }

        .invoice-container {
            width: 100%;
            margin: 0;
            padding: 0;
        }

        .table {
            width: 100%;
        }
    }
</style>