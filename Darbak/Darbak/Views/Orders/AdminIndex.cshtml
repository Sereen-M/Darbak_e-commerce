@using Darbak.Models.Enums
@model IEnumerable<Darbak.Models.Order>

@{
    ViewData["Title"] = "Manage Orders";

    string? selectedStatus =
        ViewBag.Status as string;

    string? selectedPaymentStatus =
        ViewBag.PaymentStatus as string;

    string? userFilter =
        ViewBag.UserFilter as string;

    string? fromDate =
        ViewBag.FromDate as string;

    string? toDate =
        ViewBag.ToDate as string;
}

<h1 class="mb-4">
    Manage Orders
</h1>

@if (TempData["AdminOrderSuccess"] != null)
{
    <div class="alert alert-success">
        @TempData["AdminOrderSuccess"]
    </div>
}

@if (TempData["OrderError"] != null)
{
    <div class="alert alert-danger">
        @TempData["OrderError"]
    </div>
}

<div class="card mb-4">

    <div class="card-header">
        <strong>
            Filter Orders
        </strong>
    </div>

    <div class="card-body">

        <form asp-action="AdminIndex"
              method="get">

            <div class="row g-3">

                <div class="col-md-2">

                    <label for="orderId"
                           class="form-label">
                        Order ID
                    </label>

                    <input type="number"
                           id="orderId"
                           name="orderId"
                           value="@ViewBag.OrderId"
                           min="1"
                           class="form-control"
                           placeholder="Order #" />

                </div>

                <div class="col-md-4">

                    <label for="user"
                           class="form-label">
                        User
                    </label>

                    <input type="text"
                           id="user"
                           name="user"
                           value="@userFilter"
                           class="form-control"
                           placeholder="Name or email" />

                </div>

                <div class="col-md-3">

                    <label for="status"
                           class="form-label">
                        Order Status
                    </label>

                    <select id="status"
                            name="status"
                            class="form-select">

                        <option value="">
                            All Statuses
                        </option>

                        @foreach (var statusValue
                            in Enum.GetValues<OrderStatus>())
                        {
                            if (selectedStatus ==
                                statusValue.ToString())
                            {
                                <option value="@statusValue"
                                        selected>
                                    @statusValue
                                </option>
                            }
                            else
                            {
                                <option value="@statusValue">
                                    @statusValue
                                </option>
                            }
                        }

                    </select>

                </div>

                <div class="col-md-3">

                    <label for="paymentStatus"
                           class="form-label">
                        Payment Status
                    </label>

                    <select id="paymentStatus"
                            name="paymentStatus"
                            class="form-select">

                        <option value="">
                            All Payment Statuses
                        </option>

                        @foreach (var paymentValue
                            in Enum.GetValues<PaymentStatus>())
                        {
                            if (selectedPaymentStatus ==
                                paymentValue.ToString())
                            {
                                <option value="@paymentValue"
                                        selected>
                                    @paymentValue
                                </option>
                            }
                            else
                            {
                                <option value="@paymentValue">
                                    @paymentValue
                                </option>
                            }
                        }

                    </select>

                </div>

                <div class="col-md-3">

                    <label for="fromDate"
                           class="form-label">
                        From Date
                    </label>

                    <input type="date"
                           id="fromDate"
                           name="fromDate"
                           value="@fromDate"
                           class="form-control" />

                </div>

                <div class="col-md-3">

                    <label for="toDate"
                           class="form-label">
                        To Date
                    </label>

                    <input type="date"
                           id="toDate"
                           name="toDate"
                           value="@toDate"
                           class="form-control" />

                </div>

            </div>

            <div class="d-flex gap-2 mt-4">

                <button type="submit"
                        class="btn btn-primary">
                    Apply Filters
                </button>

                <a asp-action="AdminIndex"
                   class="btn btn-outline-secondary">
                    Reset Filters
                </a>

            </div>

        </form>

    </div>

</div>

<div class="d-flex
    justify-content-between
    align-items-center
    mb-3">

    <h4 class="mb-0">
        Orders
    </h4>

    <span class="badge bg-secondary">
        @Model.Count() result(s)
    </span>

</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No orders match the selected filters.
    </div>
}
else
{
    <div class="table-responsive">

        <table class="table
            table-striped
            table-hover
            align-middle">

            <thead>

                <tr>

                    <th>
                        Order
                    </th>

                    <th>
                        User
                    </th>

                    <th>
                        Date
                    </th>

                    <th>
                        Total
                    </th>

                    <th>
                        Status
                    </th>

                    <th>
                        Payment
                    </th>

                    <th>
                        Actions
                    </th>

                </tr>

            </thead>

            <tbody>

                @foreach (var order in Model)
                {
                    <tr>

                        <td>
                            #@order.Id
                        </td>

                        <td>

                            @if (!string.IsNullOrWhiteSpace(
                                order.User.FullName))
                            {
                                <div>
                                    @order.User.FullName
                                </div>
                            }

                            <small class="text-muted">
                                @order.User.Email
                            </small>

                        </td>

                        <td>
                            @order.OrderDate
                            .ToLocalTime()
                            .ToString(
                            "dd/MM/yyyy HH:mm")
                        </td>

                        <td>
                            @order.TotalAmount
                            .ToString("0.00")
                        </td>

                        <td>

                            @switch (order.Status)
                            {
                                case OrderStatus.Completed:

                                    <span class="badge bg-success">
                                        Completed
                                    </span>

                                    break;

                                case OrderStatus.Cancelled:

                                    <span class="badge bg-danger">
                                        Cancelled
                                    </span>

                                    break;

                                default:

                                    <span class="badge
                                        bg-warning
                                        text-dark">
                                        Processing
                                    </span>

                                    break;
                            }

                        </td>

                        <td>

                            @switch (order.PaymentStatus)
                            {
                                case PaymentStatus.Paid:

                                    <span class="badge bg-success">
                                        Paid
                                    </span>

                                    break;

                                case PaymentStatus.Failed:

                                    <span class="badge bg-danger">
                                        Failed
                                    </span>

                                    break;

                                case PaymentStatus.Refunded:

                                    <span class="badge
                                        bg-info
                                        text-dark">
                                        Refunded
                                    </span>

                                    break;

                                default:

                                    <span class="badge
                                        bg-warning
                                        text-dark">
                                        Pending
                                    </span>

                                    break;
                            }

                        </td>

                        <td>

                            <a asp-action="AdminDetails"
                               asp-route-id="@order.Id"
                               class="btn
                                btn-primary
                                btn-sm">
                                Manage
                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>
}