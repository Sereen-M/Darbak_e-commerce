@model IEnumerable<Darbak.Models.Order>

@{
    ViewData["Title"] = "Manage Orders";
}

<h1>Manage Orders</h1>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No orders found.
    </div>
}
else
{
    <table class="table table-striped">

        <thead>
            <tr>
                <th>Order</th>
                <th>User</th>
                <th>Date</th>
                <th>Total</th>
                <th>Status</th>
                <th>Payment</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var order in Model)
            {
                <tr>

                    <td>
                        #@order.Id
                    </td>

                    <td>
                        @if (!string.IsNullOrEmpty(
                            order.User.FullName))
                        {
                            @order.User.FullName
                        }
                        else
                        {
                            @order.User.Email
                        }
                    </td>

                    <td>
                        @order.OrderDate
                        .ToLocalTime()
                        .ToString("dd/MM/yyyy HH:mm")
                    </td>

                    <td>
                        @order.TotalAmount.ToString("0.00")
                    </td>

                    <td>
                        @order.Status
                    </td>

                    <td>
                        @order.PaymentStatus
                    </td>

                    <td>
                        <a asp-action="AdminDetails"
                           asp-route-id="@order.Id"
                           class="btn btn-primary btn-sm">
                            Manage
                        </a>
                    </td>

                </tr>
            }

        </tbody>

    </table>
}