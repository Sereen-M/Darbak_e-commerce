@model Darbak.Models.Order

@{
    ViewData["Title"] = "Order Details";
}

@if (TempData["OrderSuccess"] != null)
{
    <div class="alert alert-success">
        @TempData["OrderSuccess"]
    </div>
}

<h1>Order #@Model.Id</h1>

<div class="card mb-4">

    <div class="card-body">

        <p>
            <strong>Order Date:</strong>
            @Model.OrderDate
            .ToLocalTime()
            .ToString("dd/MM/yyyy HH:mm")
        </p>

        <p>
            <strong>Status:</strong>

            @if (Model.Status ==
                 Darbak.Models.Enums.OrderStatus.Processing)
            {
                <span class="badge bg-warning text-dark">
                    Processing
                </span>
            }
            else if (Model.Status ==
                     Darbak.Models.Enums.OrderStatus.Completed)
            {
                <span class="badge bg-success">
                    Completed
                </span>
            }
            else
            {
                <span class="badge bg-danger">
                    Cancelled
                </span>
            }
        </p>

        <p>
            <strong>Payment Status:</strong>
            @Model.PaymentStatus
        </p>

        <hr />

        <p>
            <strong>Shipping Address:</strong>
            @Model.ShippingAddress
        </p>

        <p>
            <strong>City:</strong>
            @Model.City
        </p>

        <p>
            <strong>Phone:</strong>
            @Model.PhoneNumber
        </p>

    </div>

</div>

<h4>Products</h4>

<div class="table-responsive">

    <table class="table table-bordered">

        <thead>
            <tr>
                <th>Product</th>
                <th>Unit Price</th>
                <th>Quantity</th>
                <th>Total</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model.OrderItems)
            {
                <tr>

                    <td>
                        @item.ProductName
                    </td>

                    <td>
                        @item.UnitPrice.ToString("0.00")
                    </td>

                    <td>
                        @item.Quantity
                    </td>

                    <td>
                        @((item.UnitPrice *
                           item.Quantity)
                            .ToString("0.00"))
                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>

<h4>
    Total:
    @Model.TotalAmount.ToString("0.00")
</h4>

<a asp-action="Index"
   class="btn btn-secondary">
    Back to My Orders
</a>