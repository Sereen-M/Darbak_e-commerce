@using Darbak.Models.Enums
@model Darbak.Models.Order

@{
    ViewData["Title"] = $"Order #{Model.Id}";
}

<div class="d-flex
    justify-content-between
    align-items-start
    flex-wrap
    gap-3
    mb-4">

    <div>

        <h1 class="h2 mb-1">
            Order #@Model.Id
        </h1>

        <p class="text-muted mb-0">
            @Model.OrderDate
            .ToLocalTime()
            .ToString("dd/MM/yyyy HH:mm")
        </p>

    </div>

    <div class="d-flex gap-2 flex-wrap">

        @if (Model.Status == OrderStatus.Processing)
        {
            <span class="badge bg-warning text-dark"
                  role="status">
                Processing
            </span>
        }
        else if (Model.Status == OrderStatus.Completed)
        {
            <span class="badge bg-success"
                  role="status">
                Completed
            </span>
        }
        else
        {
            <span class="badge bg-danger"
                  role="status">
                Cancelled
            </span>
        }

        @switch (Model.PaymentStatus)
        {
            case PaymentStatus.Paid:
                <span class="badge bg-success"
                      role="status">
                    Paid
                </span>
                break;

            case PaymentStatus.Failed:
                <span class="badge bg-danger"
                      role="status">
                    Payment Failed
                </span>
                break;

            case PaymentStatus.Refunded:
                <span class="badge bg-info text-dark"
                      role="status">
                    Refunded
                </span>
                break;

            default:
                <span class="badge bg-secondary"
                      role="status">
                    Payment Pending
                </span>
                break;
        }

    </div>

</div>

<section class="card shadow-sm mb-4"
         aria-labelledby="shipping-details-heading">

    <div class="card-header">

        <h2 id="shipping-details-heading"
            class="h5 mb-0">
            Shipping Information
        </h2>

    </div>

    <div class="card-body">

        <dl class="row mb-0">

            <dt class="col-sm-3">
                Address
            </dt>

            <dd class="col-sm-9">
                @Model.ShippingAddress
            </dd>

            <dt class="col-sm-3">
                City
            </dt>

            <dd class="col-sm-9">
                @Model.City
            </dd>

            <dt class="col-sm-3">
                Phone
            </dt>

            <dd class="col-sm-9 mb-0">
                @Model.PhoneNumber
            </dd>

        </dl>

    </div>

</section>

<section aria-labelledby="order-products-heading">

    <h2 id="order-products-heading"
        class="h4 mb-3">
        Products
    </h2>

    <div class="table-responsive">

        <table class="table
            table-bordered
            align-middle">

            <caption class="visually-hidden">
                Products included in order @Model.Id
            </caption>

            <thead class="table-light">

                <tr>

                    <th scope="col">
                        Product
                    </th>

                    <th scope="col"
                        class="text-end">
                        Unit Price
                    </th>

                    <th scope="col"
                        class="text-center">
                        Quantity
                    </th>

                    <th scope="col"
                        class="text-end">
                        Total
                    </th>

                </tr>

            </thead>

            <tbody>

                @foreach (var item in Model.OrderItems)
                {
                    <tr>

                        <td>
                            @item.ProductName
                        </td>

                        <td class="text-end text-nowrap">
                            @item.UnitPrice.ToString("0.00")
                        </td>

                        <td class="text-center">
                            @item.Quantity
                        </td>

                        <td class="text-end text-nowrap">
                            @((item.UnitPrice * item.Quantity)
                                .ToString("0.00"))
                        </td>

                    </tr>
                }

            </tbody>

            <tfoot>

                <tr>

                    <th colspan="3"
                        scope="row"
                        class="text-end">
                        Order Total
                    </th>

                    <th class="text-end text-nowrap">
                        @Model.TotalAmount.ToString("0.00")
                    </th>

                </tr>

            </tfoot>

        </table>

    </div>

</section>

<div class="d-grid
    gap-2
    d-sm-flex
    mt-4">

    <a asp-action="Invoice"
       asp-route-id="@Model.Id"
       class="btn btn-primary">
        View Invoice
    </a>

    <a asp-action="Index"
       class="btn btn-outline-secondary">
        Back to My Orders
    </a>

</div>