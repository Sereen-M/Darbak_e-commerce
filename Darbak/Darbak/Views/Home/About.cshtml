@model Darbak.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "About";
}

<section class="bg-light rounded-3 p-5 mb-5">

    <div class="row align-items-center g-4">

        <div class="col-lg-7">

            <h1 class="display-5 fw-bold mb-3">
                About Darbak
            </h1>

            <p class="lead text-muted">
                Darbak is your destination for auto parts
                and car accessories.
            </p>

            <p>
                Our goal is to make finding the right
                products for your vehicle simple,
                convenient, and reliable.
            </p>

            <p class="mb-0">
                Browse our catalog, discover products
                across multiple categories, save your
                favorites, and order what you need
                through one simple shopping experience.
            </p>

        </div>

        <div class="col-lg-5">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <h4 class="mb-3">
                        Why Darbak?
                    </h4>

                    <ul class="mb-0">

                        <li class="mb-2">
                            Auto parts and car accessories
                            in one place.
                        </li>

                        <li class="mb-2">
                            Simple product search and
                            category browsing.
                        </li>

                        <li class="mb-2">
                            Product ratings and reviews.
                        </li>

                        <li class="mb-2">
                            Wishlist and shopping cart.
                        </li>

                        <li>
                            Easy order tracking.
                        </li>

                    </ul>

                </div>

            </div>

        </div>

    </div>

</section>

<section class="mb-5">

    <div class="text-center mb-4">

        <h2>
            What Our Customers Say
        </h2>

        <p class="text-muted">
            Feedback from Darbak customers.
        </p>

    </div>

    @if (!Model.Testimonials.Any())
    {
        <div class="alert alert-info text-center">
            No testimonials are available yet.
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var testimonial
                in Model.Testimonials)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card h-100 shadow-sm">

                        <div class="card-body
                            d-flex
                            flex-column">

                            <div class="fs-1
                                text-muted
                                lh-1
                                mb-2">
                                “
                            </div>

                            <p class="card-text flex-grow-1">
                                @testimonial.Content
                            </p>

                            <hr />

                            <div>

                                <strong>
                                    @testimonial.UserName
                                </strong>

                                <div class="text-muted small">
                                    @testimonial.CreatedAt
                                    .ToLocalTime()
                                    .ToString("dd/MM/yyyy")
                                </div>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</section>

<section class="text-center
    border
    rounded-3
    p-5
    mb-4">

    <h2 class="mb-3">
        Find What Your Car Needs
    </h2>

    <p class="text-muted mb-4">
        Explore the Darbak catalog and discover
        available auto parts and accessories.
    </p>

    <a asp-controller="Catalog"
       asp-action="Index"
       class="btn btn-primary btn-lg">
        Browse Products
    </a>

</section>