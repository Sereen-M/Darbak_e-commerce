@model List<Darbak.ViewModels.CartItemViewModel>

@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="d-flex
    justify-content-between
    align-items-center
    flex-wrap
    gap-2
    mb-4">

    <div>
        <h1 class="h2 mb-1">
            Shopping Cart
        </h1>

        <p class="text-muted mb-0">
            Review your items before checkout.
        </p>
    </div>

    <a asp-controller="Catalog"
       asp-action="Index"
       class="btn btn-outline-primary">
        Continue Shopping
    </a>

</div>

@if (Model == null || !Model.Any())
{
    <div class="text-center
        border
        rounded
        bg-light
        p-5">

        <h2 class="h4 mb-2">
            Your cart is empty
        </h2>

        <p class="text-muted mb-3">
            Browse the catalog and add products to your cart.
        </p>

        <a asp-controller="Catalog"
           asp-action="Index"
           class="btn btn-primary">
            Browse Products
        </a>

    </div>
}
else
{
    <div class="table-responsive">

        <table class="table
            table-bordered
            align-middle">

            <caption class="visually-hidden">
                Products currently in your shopping cart
            </caption>

            <thead class="table-light">

                <tr>
                    <th scope="col">
                        Image
                    </th>

                    <th scope="col">
                        Product
                    </th>

                    <th scope="col">
                        Price
                    </th>

                    <th scope="col">
                        Quantity
                    </th>

                    <th scope="col">
                        Total
                    </th>

                    <th scope="col">
                        Actions
                    </th>
                </tr>

            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    var quantityId =
                        $"quantity-{item.ProductId}";

                    <tr>

                        <td style="width: 100px;">

                            @if (!string.IsNullOrWhiteSpace(
                                item.ImageUrl))
                            {
                                <img src="@item.ImageUrl"
                                     alt="@item.ProductName"
                                     class="rounded"
                                     loading="lazy"
                                     width="80"
                                     height="80"
                                     style="object-fit: cover;" />
                            }
                            else
                            {
                                <div class="d-flex
                                    align-items-center
                                    justify-content-center
                                    bg-light
                                    text-muted
                                    rounded"
                                     style="width: 80px;
                                    height: 80px;"
                                     aria-label="No image available">

                                    No Image

                                </div>
                            }

                        </td>

                        <td>

                            <a asp-controller="Products"
                               asp-action="Details"
                               asp-route-id="@item.ProductId"
                               class="fw-semibold
                                text-decoration-none">

                                @item.ProductName

                            </a>

                        </td>

                        <td class="text-nowrap">
                            @item.Price.ToString("0.00")
                        </td>

                        <td>

                            <form asp-controller="Cart"
                                  asp-action="UpdateQuantity"
                                  method="post"
                                  class="d-flex
                                flex-column
                                flex-sm-row
                                gap-2">

                                <input type="hidden"
                                       name="productId"
                                       value="@item.ProductId" />

                                <label for="@quantityId"
                                       class="visually-hidden">
                                    Quantity for @item.ProductName
                                </label>

                                <input type="number"
                                       id="@quantityId"
                                       name="quantity"
                                       value="@item.Quantity"
                                       min="1"
                                       inputmode="numeric"
                                       class="form-control"
                                       style="max-width: 100px;"
                                       aria-label="Quantity for @item.ProductName" />

                                <button type="submit"
                                        class="btn btn-outline-primary">
                                    Update
                                </button>

                            </form>

                        </td>

                        <td class="fw-semibold text-nowrap">
                            @item.Total.ToString("0.00")
                        </td>

                        <td>

                            <form asp-controller="Cart"
                                  asp-action="Remove"
                                  method="post">

                                <input type="hidden"
                                       name="productId"
                                       value="@item.ProductId" />

                                <button type="submit"
                                        class="btn btn-outline-danger"
                                        aria-label="Remove @item.ProductName from cart"
                                        onclick="return confirm('Remove this product from your cart?');">

                                    Remove

                                </button>

                            </form>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

    <div class="row g-3 mt-3">

        <div class="col-12 col-md-6">

            <form asp-controller="Cart"
                  asp-action="Clear"
                  method="post">

                <button type="submit"
                        class="btn btn-outline-danger"
                        onclick="return confirm('Clear the entire cart?');">

                    Clear Cart

                </button>

            </form>

        </div>

        <div class="col-12 col-md-6">

            <div class="card shadow-sm">

                <div class="card-body text-md-end">

                    <p class="text-muted mb-1">
                        Order Total
                    </p>

                    <h2 class="h3 mb-3">
                        @Model.Sum(x => x.Total).ToString("0.00")
                    </h2>

                    <a asp-controller="Orders"
                       asp-action="Checkout"
                       class="btn btn-success btn-lg">

                        Proceed to Checkout

                    </a>

                </div>

            </div>

        </div>

    </div>
}