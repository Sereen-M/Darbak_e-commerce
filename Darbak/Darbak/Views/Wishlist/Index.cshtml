@model IEnumerable<Darbak.Models.WishlistItem>

@{
    ViewData["Title"] = "My Wishlist";
}

<h1>My Wishlist</h1>

@if (TempData["WishlistSuccess"] != null)
{
    <div class="alert alert-success">
        @TempData["WishlistSuccess"]
    </div>
}

@if (TempData["WishlistInfo"] != null)
{
    <div class="alert alert-info">
        @TempData["WishlistInfo"]
    </div>
}

@if (TempData["WishlistError"] != null)
{
    <div class="alert alert-danger">
        @TempData["WishlistError"]
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        Your wishlist is empty.
    </div>

    <a asp-controller="Home"
       asp-action="Index"
       class="btn btn-secondary">
        Back to Home
    </a>
}
else
{
    <div class="row">

        @foreach (var item in Model)
        {
            var mainImage =
                item.Product.Images
                    .OrderByDescending(i => i.IsMain)
                    .ThenBy(i => i.Id)
                    .FirstOrDefault();

            <div class="col-md-4 mb-4">

                <div class="card h-100">

                    @if (mainImage != null)
                    {
                        <img src="@mainImage.ImageUrl"
                             class="card-img-top"
                             alt="@item.Product.Name"
                             style="height: 220px;
                        object-fit: cover;" />
                    }
                    else
                    {
                        <div class="d-flex
                            align-items-center
                            justify-content-center
                            bg-light text-muted"
                             style="height: 220px;">
                            No Image
                        </div>
                    }

                    <div class="card-body">

                        <h5 class="card-title">
                            @item.Product.Name
                        </h5>

                        <p class="card-text">
                            <strong>Price:</strong>
                            @item.Product.Price.ToString("0.00")
                        </p>

                        @if (!item.Product.IsActive)
                        {
                            <div class="alert alert-warning py-2">
                                This product is currently unavailable.
                            </div>
                        }
                        else if (item.Product.StockQuantity <= 0)
                        {
                            <div class="alert alert-warning py-2">
                                This product is currently out of stock.
                            </div>
                        }

                    </div>

                    <div class="card-footer bg-transparent">

                        @if (item.Product.IsActive)
                        {
                            <a asp-controller="Products"
                               asp-action="Details"
                               asp-route-id="@item.ProductId"
                               class="btn btn-primary btn-sm">
                                View Product
                            </a>
                        }

                        <form asp-action="Remove"
                              method="post"
                              class="d-inline">

                            <input type="hidden"
                                   name="id"
                                   value="@item.Id" />

                            <button type="submit"
                                    class="btn btn-danger btn-sm"
                                    onclick="return confirm('Remove this product from your wishlist?');">
                                Remove
                            </button>

                        </form>

                    </div>

                </div>

            </div>
        }

    </div>
}