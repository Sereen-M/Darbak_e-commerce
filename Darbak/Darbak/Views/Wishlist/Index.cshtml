@model IEnumerable<Darbak.Models.WishlistItem>

@{
    ViewData["Title"] = "My Wishlist";
}

<h1>My Wishlist</h1>

@if (TempData["WishlistSuccess"] != null)
{
    <div class="alert alert-success">
        @TempData["WishlistSuccess"]
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        Your wishlist is empty.
    </div>

    <a asp-controller="Products"
       asp-action="Index"
       class="btn btn-primary">
        Browse Products
    </a>
}
else
{
    <div class="row">

        @foreach (var item in Model)
        {
            var mainImage =
                item.Product.Images
                    .FirstOrDefault(i => i.IsMain)
                ?? item.Product.Images
                    .FirstOrDefault();

            <div class="col-md-4 mb-4">

                <div class="card h-100">

                    @if (mainImage != null)
                    {
                        <img src="@mainImage.ImageUrl"
                             class="card-img-top"
                             alt="@item.Product.Name" />
                    }

                    <div class="card-body">

                        <h5 class="card-title">
                            @item.Product.Name
                        </h5>

                        <p class="card-text">
                            Price:
                            @item.Product.Price.ToString("0.00")
                        </p>

                        @if (!item.Product.IsActive)
                        {
                            <p class="text-danger">
                                Currently unavailable
                            </p>
                        }
                        else if (item.Product.StockQuantity <= 0)
                        {
                            <p class="text-danger">
                                Out of Stock
                            </p>
                        }

                        <a asp-controller="Products"
                           asp-action="Details"
                           asp-route-id="@item.ProductId"
                           class="btn btn-primary">
                            View Product
                        </a>

                        <form asp-action="Remove"
                              method="post"
                              class="d-inline">

                            <input type="hidden"
                                   name="id"
                                   value="@item.Id" />

                            <button type="submit"
                                    class="btn btn-danger"
                                    onclick="return confirm('Remove this product from your wishlist?');">
                                Remove
                            </button>

                        </form>

                    </div>

                </div>

            </div>
        }

    </div>
}