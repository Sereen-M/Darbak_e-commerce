@using Darbak.Models.Enums
@model Darbak.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="mb-4">

    <h1 class="h2 mb-1">
        Admin Dashboard
    </h1>

    <p class="text-muted mb-0">
        Overview of Darbak store activity.
    </p>

</div>

<section aria-labelledby="main-statistics-heading"
         class="mb-4">

    <h2 id="main-statistics-heading"
        class="visually-hidden">
        Main Statistics
    </h2>

    <div class="row g-3">

        <div class="col-12 col-sm-6 col-xl-3">

            <div class="card h-100 shadow-sm">

                <div class="card-body">

                    <p class="text-muted mb-1">
                        Products
                    </p>

                    <p class="display-6 fw-semibold mb-1">
                        @Model.TotalProducts
                    </p>

                    <small class="text-muted">
                        @Model.ActiveProducts active
                    </small>

                </div>

            </div>

        </div>

        <div class="col-12 col-sm-6 col-xl-3">

            <div class="card h-100 shadow-sm">

                <div class="card-body">

                    <p class="text-muted mb-1">
                        Categories
                    </p>

                    <p class="display-6 fw-semibold mb-0">
                        @Model.TotalCategories
                    </p>

                </div>

            </div>

        </div>

        <div class="col-12 col-sm-6 col-xl-3">

            <div class="card h-100 shadow-sm">

                <div class="card-body">

                    <p class="text-muted mb-1">
                        Users
                    </p>

                    <p class="display-6 fw-semibold mb-0">
                        @Model.TotalUsers
                    </p>

                </div>

            </div>

        </div>

        <div class="col-12 col-sm-6 col-xl-3">

            <div class="card h-100 shadow-sm">

                <div class="card-body">

                    <p class="text-muted mb-1">
                        Orders
                    </p>

                    <p class="display-6 fw-semibold mb-0">
                        @Model.TotalOrders
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>

<div class="row g-3 mb-4">

    <div class="col-12 col-md-4">

        <div class="card h-100 shadow-sm">

            <div class="card-body">

                <p class="text-muted mb-1">
                    Total Order Value
                </p>

                <h2 class="h3 mb-0">
                    @Model.TotalOrderValue.ToString("0.00")
                </h2>

            </div>

        </div>

    </div>

    <div class="col-12 col-md-4">

        <div class="card h-100 shadow-sm">

            <div class="card-body">

                <p class="text-muted mb-1">
                    Pending Reviews
                </p>

                <h2 class="h3">
                    @Model.PendingReviews
                </h2>

                <a asp-controller="Reviews"
                   asp-action="Index"
                   class="btn btn-sm btn-outline-primary">

                    Manage Reviews

                </a>

            </div>

        </div>

    </div>

    <div class="col-12 col-md-4">

        <div class="card h-100 shadow-sm">

            <div class="card-body">

                <p class="text-muted mb-1">
                    Pending Testimonials
                </p>

                <h2 class="h3">
                    @Model.PendingTestimonials
                </h2>

                <a asp-controller="Testimonials"
                   asp-action="AdminIndex"
                   class="btn btn-sm btn-outline-primary">

                    Manage Testimonials

                </a>

            </div>

        </div>

    </div>

</div>

<div class="row g-4 mb-4">

    <div class="col-12 col-lg-6">

        <section class="card h-100 shadow-sm"
                 aria-labelledby="orders-status-heading">

            <div class="card-header">

                <h2 id="orders-status-heading"
                    class="h5 mb-0">
                    Orders by Status
                </h2>

            </div>

            <div class="card-body">

                @if (!Model.OrdersByStatus.Any())
                {
                    <p class="text-muted mb-0">
                        No order data is available.
                    </p>
                }
                else
                {
                    @foreach (var item in Model.OrdersByStatus)
                    {
                        <div class="d-flex
                            justify-content-between
                            align-items-center
                            border-bottom
                            py-2">

                            <span>
                                @item.Key
                            </span>

                            <span class="badge bg-secondary">
                                @item.Value
                            </span>

                        </div>
                    }
                }

            </div>

        </section>

    </div>

    <div class="col-12 col-lg-6">

        <section class="card h-100 shadow-sm"
                 aria-labelledby="payments-status-heading">

            <div class="card-header">

                <h2 id="payments-status-heading"
                    class="h5 mb-0">
                    Orders by Payment Status
                </h2>

            </div>

            <div class="card-body">

                @if (!Model.OrdersByPaymentStatus.Any())
                {
                    <p class="text-muted mb-0">
                        No payment data is available.
                    </p>
                }
                else
                {
                    @foreach (var item in Model.OrdersByPaymentStatus)
                    {
                        <div class="d-flex
                            justify-content-between
                            align-items-center
                            border-bottom
                            py-2">

                            <span>
                                @item.Key
                            </span>

                            <span class="badge bg-secondary">
                                @item.Value
                            </span>

                        </div>
                    }
                }

            </div>

        </section>

    </div>

</div>

<div class="row g-4 mb-4">

    <div class="col-12 col-xl-8">

        <section class="card h-100 shadow-sm"
                 aria-labelledby="recent-orders-heading">

            <div class="card-header
                d-flex
                justify-content-between
                align-items-center
                flex-wrap
                gap-2">

                <h2 id="recent-orders-heading"
                    class="h5 mb-0">
                    Recent Orders
                </h2>

                <a asp-controller="Orders"
                   asp-action="AdminIndex"
                   class="btn btn-sm btn-outline-primary">
                    View All
                </a>

            </div>

            <div class="card-body">

                @if (!Model.RecentOrders.Any())
                {
                    <div class="text-center
                        border
                        rounded
                        bg-light
                        p-4">

                        <p class="text-muted mb-0">
                            No orders are available yet.
                        </p>

                    </div>
                }
                else
                {
                    <div class="table-responsive">

                        <table class="table
                            table-hover
                            align-middle">

                            <caption class="visually-hidden">
                                Most recent store orders
                            </caption>

                            <thead>

                                <tr>

                                    <th scope="col">
                                        Order
                                    </th>

                                    <th scope="col">
                                        User
                                    </th>

                                    <th scope="col">
                                        Date
                                    </th>

                                    <th scope="col"
                                        class="text-end">
                                        Total
                                    </th>

                                    <th scope="col">
                                        Status
                                    </th>

                                    <th scope="col">
                                        Payment
                                    </th>

                                    <th scope="col"
                                        class="text-end">
                                        Actions
                                    </th>

                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var order in Model.RecentOrders)
                                {
                                    <tr>

                                        <td class="text-nowrap">
                                            #@order.Id
                                        </td>

                                        <td>
                                            @order.UserName
                                        </td>

                                        <td class="text-nowrap">

                                            @order.OrderDate
                                            .ToLocalTime()
                                            .ToString("dd MMM yyyy")

                                        </td>

                                        <td class="text-end text-nowrap">
                                            @order.TotalAmount.ToString("0.00")
                                        </td>

                                        <td>

                                            @if (order.Status ==
                                                OrderStatus.Processing)
                                            {
                                                <span class="badge
                                                    bg-warning
                                                    text-dark">
                                                    Processing
                                                </span>
                                            }
                                            else if (order.Status ==
                                                     OrderStatus.Completed)
                                            {
                                                <span class="badge bg-success">
                                                    Completed
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">
                                                    Cancelled
                                                </span>
                                            }

                                        </td>

                                        <td>

                                            @if (order.PaymentStatus ==
                                                PaymentStatus.Paid)
                                            {
                                                <span class="badge bg-success">
                                                    Paid
                                                </span>
                                            }
                                            else if (order.PaymentStatus ==
                                                     PaymentStatus.Failed)
                                            {
                                                <span class="badge bg-danger">
                                                    Failed
                                                </span>
                                            }
                                            else if (order.PaymentStatus ==
                                                     PaymentStatus.Refunded)
                                            {
                                                <span class="badge
                                                    bg-info
                                                    text-dark">
                                                    Refunded
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge
                                                    bg-secondary">
                                                    Pending
                                                </span>
                                            }

                                        </td>

                                        <td class="text-end">

                                            <a asp-controller="Orders"
                                               asp-action="AdminDetails"
                                               asp-route-id="@order.Id"
                                               class="btn
                                                btn-sm
                                                btn-outline-primary">

                                                Details

                                            </a>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </div>

        </section>

    </div>

    <div class="col-12 col-xl-4">

        <section class="card h-100 shadow-sm"
                 aria-labelledby="quick-actions-heading">

            <div class="card-header">

                <h2 id="quick-actions-heading"
                    class="h5 mb-0">
                    Quick Actions
                </h2>

            </div>

            <div class="card-body d-grid gap-2">

                <a asp-controller="Products"
                   asp-action="Index"
                   class="btn btn-outline-primary">
                    Manage Products
                </a>

                <a asp-controller="Categories"
                   asp-action="Index"
                   class="btn btn-outline-primary">
                    Manage Categories
                </a>

                <a asp-controller="Orders"
                   asp-action="AdminIndex"
                   class="btn btn-outline-primary">
                    Manage Orders
                </a>

                <a asp-controller="AdminUsers"
                   asp-action="Index"
                   class="btn btn-outline-primary">
                    Manage Users
                </a>

                <a asp-controller="Reviews"
                   asp-action="Index"
                   class="btn btn-outline-primary">
                    Manage Reviews
                </a>

                <a asp-controller="Testimonials"
                   asp-action="AdminIndex"
                   class="btn btn-outline-primary">
                    Manage Testimonials
                </a>

            </div>

        </section>

    </div>

</div>

<section class="card shadow-sm mb-4"
         aria-labelledby="low-stock-heading">

    <div class="card-header">

        <h2 id="low-stock-heading"
            class="h5 mb-0">
            Low Stock Products
        </h2>

    </div>

    <div class="card-body">

        @if (!Model.LowStockProducts.Any())
        {
            <div class="text-center
                border
                rounded
                bg-light
                p-4">

                <p class="text-muted mb-0">
                    No active products have low stock.
                </p>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table
                    table-hover
                    align-middle">

                    <caption class="visually-hidden">
                        Active products with low stock
                    </caption>

                    <thead>

                        <tr>

                            <th scope="col">
                                Product
                            </th>

                            <th scope="col"
                                class="text-center">
                                Stock
                            </th>

                            <th scope="col"
                                class="text-end">
                                Price
                            </th>

                            <th scope="col"
                                class="text-end">
                                Actions
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var product in Model.LowStockProducts)
                        {
                            <tr>

                                <td>
                                    @product.Name
                                </td>

                                <td class="text-center">

                                    <span class="badge bg-warning text-dark">
                                        @product.StockQuantity
                                    </span>

                                </td>

                                <td class="text-end text-nowrap">
                                    @product.Price.ToString("0.00")
                                </td>

                                <td class="text-end">

                                    <a asp-controller="Products"
                                       asp-action="Edit"
                                       asp-route-id="@product.Id"
                                       class="btn
                                        btn-sm
                                        btn-outline-primary">

                                        Edit

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</section>