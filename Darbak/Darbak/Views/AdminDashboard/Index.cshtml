@model Darbak.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container">

    <div class="mb-4">
        <h1 class="mb-1">
            Admin Dashboard
        </h1>

        <p class="text-muted mb-0">
            Overview of Darbak store activity.
        </p>
    </div>

    <!-- Main Statistics -->
    <div class="row g-3 mb-4">

        <div class="col-md-6 col-lg-3">
            <div class="card h-100">
                <div class="card-body">

                    <h6 class="text-muted">
                        Products
                    </h6>

                    <h2>
                        @Model.TotalProducts
                    </h2>

                    <small class="text-muted">
                        @Model.ActiveProducts active
                    </small>

                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card h-100">
                <div class="card-body">

                    <h6 class="text-muted">
                        Categories
                    </h6>

                    <h2>
                        @Model.TotalCategories
                    </h2>

                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card h-100">
                <div class="card-body">

                    <h6 class="text-muted">
                        Users
                    </h6>

                    <h2>
                        @Model.TotalUsers
                    </h2>

                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card h-100">
                <div class="card-body">

                    <h6 class="text-muted">
                        Orders
                    </h6>

                    <h2>
                        @Model.TotalOrders
                    </h2>

                </div>
            </div>
        </div>

    </div>

    <!-- Secondary Statistics -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">

                    <h6 class="text-muted">
                        Total Order Value
                    </h6>

                    <h3>
                        @Model.TotalOrderValue.ToString("0.00")
                    </h3>

                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">

                    <h6 class="text-muted">
                        Pending Reviews
                    </h6>

                    <h3>
                        @Model.PendingReviews
                    </h3>

                    <a asp-controller="Reviews"
                       asp-action="Index"
                       class="btn btn-sm btn-outline-primary">
                        Manage Reviews
                    </a>

                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">

                    <h6 class="text-muted">
                        Pending Testimonials
                    </h6>

                    <h3>
                        @Model.PendingTestimonials
                    </h3>

                    <a asp-controller="Testimonials"
                       asp-action="AdminIndex"
                       class="btn btn-sm btn-outline-primary">
                        Manage Testimonials
                    </a>

                </div>
            </div>
        </div>

    </div>

    <!-- Status Statistics -->
    <div class="row g-4 mb-4">

        <div class="col-lg-6">

            <div class="card h-100">

                <div class="card-header">
                    Orders by Status
                </div>

                <div class="card-body">

                    @foreach (var item in Model.OrdersByStatus)
                    {
                        <div class="d-flex justify-content-between border-bottom py-2">

                            <span>
                                @item.Key
                            </span>

                            <strong>
                                @item.Value
                            </strong>

                        </div>
                    }

                </div>

            </div>

        </div>

        <div class="col-lg-6">

            <div class="card h-100">

                <div class="card-header">
                    Orders by Payment Status
                </div>

                <div class="card-body">

                    @foreach (var item in Model.OrdersByPaymentStatus)
                    {
                        <div class="d-flex justify-content-between border-bottom py-2">

                            <span>
                                @item.Key
                            </span>

                            <strong>
                                @item.Value
                            </strong>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

    <div class="row g-4 mb-4">

        <!-- Recent Orders -->
        <div class="col-lg-8">

            <div class="card h-100">

                <div class="card-header d-flex justify-content-between align-items-center">

                    <span>
                        Recent Orders
                    </span>

                    <a asp-controller="Orders"
                       asp-action="AdminIndex"
                       class="btn btn-sm btn-outline-primary">
                        View All
                    </a>

                </div>

                <div class="card-body">

                    @if (!Model.RecentOrders.Any())
                    {
                        <div class="alert alert-info mb-0">
                            No orders are available yet.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">

                            <table class="table table-hover align-middle">

                                <thead>
                                    <tr>
                                        <th>Order</th>
                                        <th>User</th>
                                        <th>Date</th>
                                        <th>Total</th>
                                        <th>Status</th>
                                        <th>Payment</th>
                                        <th></th>
                                    </tr>
                                </thead>

                                <tbody>

                                    @foreach (var order in Model.RecentOrders)
                                    {
                                        <tr>

                                            <td>
                                                #@order.Id
                                            </td>

                                            <td>
                                                @order.UserName
                                            </td>

                                            <td>
                                                @order.OrderDate
                                                .ToLocalTime()
                                                .ToString("dd MMM yyyy")
                                            </td>

                                            <td>
                                                @order.TotalAmount.ToString("0.00")
                                            </td>

                                            <td>
                                                @order.Status
                                            </td>

                                            <td>
                                                @order.PaymentStatus
                                            </td>

                                            <td>
                                                <a asp-controller="Orders"
                                                   asp-action="AdminDetails"
                                                   asp-route-id="@order.Id"
                                                   class="btn btn-sm btn-outline-secondary">
                                                    Details
                                                </a>
                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }

                </div>

            </div>

        </div>

        <!-- Quick Actions -->
        <div class="col-lg-4">

            <div class="card h-100">

                <div class="card-header">
                    Quick Actions
                </div>

                <div class="card-body d-grid gap-2">

                    <a asp-controller="Products"
                       asp-action="Index"
                       class="btn btn-outline-primary">
                        Manage Products
                    </a>

                    <a asp-controller="Categories"
                       asp-action="Index"
                       class="btn btn-outline-primary">
                        Manage Categories
                    </a>

                    <a asp-controller="Orders"
                       asp-action="AdminIndex"
                       class="btn btn-outline-primary">
                        Manage Orders
                    </a>

                    <a asp-controller="Reviews"
                       asp-action="Index"
                       class="btn btn-outline-primary">
                        Manage Reviews
                    </a>

                    <a asp-controller="Testimonials"
                       asp-action="AdminIndex"
                       class="btn btn-outline-primary">
                        Manage Testimonials
                    </a>

                </div>

            </div>

        </div>

    </div>

    <!-- Low Stock -->
    <div class="card mb-4">

        <div class="card-header">
            Low Stock Products
        </div>

        <div class="card-body">

            @if (!Model.LowStockProducts.Any())
            {
                <div class="alert alert-success mb-0">
                    No active products have low stock.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Stock</th>
                                <th>Price</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var product in Model.LowStockProducts)
                            {
                                <tr>

                                    <td>
                                        @product.Name
                                    </td>

                                    <td>
                                        @product.StockQuantity
                                    </td>

                                    <td>
                                        @product.Price.ToString("0.00")
                                    </td>

                                    <td>
                                        <a asp-controller="Products"
                                           asp-action="Edit"
                                           asp-route-id="@product.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Edit
                                        </a>
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>